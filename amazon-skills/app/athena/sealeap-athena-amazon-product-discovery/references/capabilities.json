      "name": "sealeap-athena-amazon-product-search",
      "title": "Amazon 商品检索",
      "description": "Amazon 商品检索。用于先定义筛选口径，再检索并按 child ASIN 去重，核对与需求的匹配程度。输入需明确站点、搜索词、价格和规格筛选、页数上限；边界见执行手册。",
      "category": "Amazon",
      "mode": "data",
      "route": "Sorftime 直接工具",
      "capabilities": [
        {
          "provider": "sorftime",
          "tool": "product_search_from_name",
          "validation": "tool_schema",
          "required_fields": [
            "name"
          ]
